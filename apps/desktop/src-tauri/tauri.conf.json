{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rowhouse",
  "version": "0.2.0",
  "identifier": "id.morfotech.rowhouse",
  "build": {
    "beforeDevCommand": "node ../../scripts/sidecar.mjs debug && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node ../../scripts/sidecar.mjs release && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Rowhouse",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 18
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Fast, compact database client",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/rowhouse-mcp"
    ]
  }
}
