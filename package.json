{
  "name": "rowhouse",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter rowhouse-desktop tauri dev",
    "dev:ui": "pnpm --filter rowhouse-desktop dev",
    "build": "pnpm --filter rowhouse-desktop tauri build",
    "typecheck": "pnpm --filter rowhouse-desktop exec tsc --noEmit",
    "test": "cargo test --workspace",
    "prepare": "husky",
    "sidecar": "node scripts/sidecar.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7"
  }
}
